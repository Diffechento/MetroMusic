local.jar

# Machine-specific, and the place the secrets live.
#
# local.properties carries sdk.dir *and* the Last.fm application credentials
# (LASTFM_API_KEY / LASTFM_API_SECRET) that app/build.gradle.kts reads into BuildConfig.
# See local.properties.example. Never commit the real one.
local.properties

# Release signing. keystore.properties names the keystore and holds both passwords.
keystore.properties
*.jks
*.keystore

# The working notes kept beside the project — how to build, test and extend it, written for whoever
# picks it up next. Deliberately not published: it is a log of local traps, device names and paths,
# not documentation of the app. README.md and CHANGELOG.md are what the repository says.
CLAUDE.md

