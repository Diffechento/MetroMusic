<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading the on-device music library. Split at API 33, where the storage
         permissions were replaced by per-media-type ones. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Editing an album's tags writes the files. From Android 10 that is granted per file through a
         system dialog instead (see MetadataWriter), so this only exists for the versions below it,
         where there is no dialog and the write needs the blanket permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- "Media management", API 31+. Optional, and off until the user goes and grants it in
         Settings -> Apps -> Special app access; with it, the per-file write dialog above is answered
         once instead of once per album, which is the whole reason it exists. Everything works
         without it — the dialog is simply asked every time. -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- The playback notification. Only prompted for on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Lyrics from Genius and scrobbling to Last.fm. Both are opt-in features that fail soft:
         nothing here is needed to play the music that is already on the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MetroMusicApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MetroMusic"
        tools:targetApi="34">

        <!-- singleTop so that a file opened while the app is already running arrives at the
             instance that is on screen, through onNewIntent, instead of stacking a second copy of
             the shell on top of the first. It is also what makes the widget's `screen` extra work
             against a running activity, which it never did. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MetroMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Opening an audio file from a file manager, a download or an attachment. Two
                 filters rather than one: a mime type and a scheme in the same <data> element are
                 an AND, so the type-only filter is what catches the content uris every modern
                 provider hands out, and the second one catches the file: and http(s) uris older
                 apps still send with no type attached. The extensions are listed because a
                 provider that knows nothing about a file offers it as application/octet-stream. -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
            </intent-filter>
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.mka" />
            </intent-filter>
        </activity>

        <!-- WP8-style live tile. Extends the framework's MetroWidgetProvider; the
             provider-info xml lives in the :metro library and is merged in. -->
        <receiver
            android:name=".widget.NowPlayingTile"
            android:exported="true"
            android:label="MetroMusic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/metro_tile_info" />
        </receiver>

        <!-- Media3 hosts the session here: notification, lock screen, headset and
             Bluetooth controls all hang off this one service. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
