## Copy to `local.properties` and fill in. That file is untracked — it is where the
## machine-specific and the secret both live.

# Where your Android SDK is. Android Studio writes this line for you on first sync.
sdk.dir=/path/to/Android/Sdk

# Your own Last.fm application credentials, if you want them instead of the ones the project
# ships in lastfm.properties. Read at build time into BuildConfig (see app/build.gradle.kts); left
# empty, the committed pair is used. Get a pair at https://www.last.fm/api/account/create
#
# A key typed into the app's Last.fm settings page wins over both.
LASTFM_API_KEY=
LASTFM_API_SECRET=
